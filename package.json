{
  "name": "jevladder",
  "version": "0.6.0",
  "description": "Ladder-gate for AI agents: deterministic rules first, an AI judge for the grey zone, and a hard human fallback.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaraldSigvartsen/jevladder.git"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jevladder": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "!dist/src/**/*.map",
    "plugin",
    "README.md",
    "LICENSE",
    "docs/SECURITY.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/HaraldSigvartsen/jevladder#readme",
  "bugs": {
    "url": "https://github.com/HaraldSigvartsen/jevladder/issues"
  },
  "keywords": ["ai-agents", "model-routing", "merge-gate", "cli", "codex", "claude-code"],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "npm run build && node dist/eval/run.js",
    "eval:independent": "npm run build && node dist/eval/independent/run.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  }
}
